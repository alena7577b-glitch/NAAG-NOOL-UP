# ==============================================================================
# NAAG NOOL UP — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real secret keys, service-role keys, or database credentials to git.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Connection Pooling)
# ------------------------------------------------------------------------------
# For local dev / direct connection (port 5432):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/naag_nool_up?schema=public"
#
# For Supabase Production (Transaction Pooler - port 6543, recommended for Next.js serverless):
# DATABASE_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Direct connection string for Prisma migrations (Session Mode - port 5432):
# DIRECT_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DATABASE_URL=
DIRECT_URL=

# ------------------------------------------------------------------------------
# 2. SUPABASE API CONFIGURATION
# ------------------------------------------------------------------------------
# Public Supabase URL (Available on client & server):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous Key (RLS-enforced, safe for browser client):
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# CRITICAL SECURITY RULE:
# SUPABASE_SERVICE_ROLE_KEY MUST NEVER be prefixed with NEXT_PUBLIC_
# or exposed to the browser. This key bypasses all Row Level Security (RLS)
# and must ONLY be used on the trusted server.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase Storage Buckets
SUPABASE_STORAGE_PUBLIC_BUCKET=naag-nool-public-media
SUPABASE_STORAGE_PRIVATE_BUCKET=naag-nool-private-docs

# ------------------------------------------------------------------------------
# 3. APPLICATION & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=your-random-32-character-secret-key

# ------------------------------------------------------------------------------
# 4. PAYMENT PROVIDER CONFIGURATION (Future Client-Approved Gateway)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. EMAIL PROVIDER CONFIGURATION (Optional / Future Notification Service)
# ------------------------------------------------------------------------------
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@naagnoolup.com
